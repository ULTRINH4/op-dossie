<section class="tab op-tab-body {{tab.cssClass}}" data-group="primary" data-tab="rituals">
	<div class="op-ritual-head">
		<div class="op-dt"><span>DT dos rituais</span><strong>{{system.dtRitual}}</strong></div>
		<p class="op-hint">Arraste rituais do compêndio <em>Rituais</em>. Use <strong>Conjurar</strong> para escolher a forma (normal, discente ou verdadeira): o custo sai do seu {{costLabel}} e o teste de Ocultismo é feito sozinho.</p>
	</div>
	{{#each ritualCircles}}
	<div class="op-section">
		<header class="op-section__head">
			<h2>{{label}}</h2>
			{{#if ../editable}}<button type="button" class="op-add" data-action="criar" data-type="ritual" data-circulo="{{circle}}"><i class="fa-solid fa-plus" aria-hidden="true"></i> Ritual</button>{{/if}}
		</header>
		{{#if items.length}}
		<div class="op-cols op-cols--ritual" aria-hidden="true"><span></span><span>Ritual</span><span>Custo</span><span>Execução</span><span>Alcance</span><span>Resistência</span><span>Formas</span><span></span><span></span></div>
		<ol class="op-list op-list--ritual">
			{{#each items}}
			{{#> opItemRow this edit=../../edit rollAction="conjurar"}}
			<span class="op-cell op-cell--strong">{{cost}}</span>
			<span class="op-cell">{{execution}}</span>
			<span class="op-cell">{{range}}</span>
			<span class="op-cell">{{resistance}}{{#if damage}}<small>{{damage}}</small>{{/if}}</span>
			<span class="op-forms">
				{{#if discente}}<span class="op-form" data-tooltip="Discente ({{discente}} PE)">D</span>{{/if}}
				{{#if verdadeiro}}<span class="op-form op-form--v" data-tooltip="Verdadeiro ({{verdadeiro}} PE)">V</span>{{/if}}
			</span>
			<button type="button" class="op-castbtn" data-action="conjurar" aria-label="Conjurar {{name}}"><i class="fa-solid fa-hand-sparkles" aria-hidden="true"></i> Conjurar</button>
			{{/opItemRow}}
			{{/each}}
		</ol>
		{{else}}<p class="op-empty">Nenhum ritual deste círculo.</p>{{/if}}
	</div>
	{{else}}
	<p class="op-empty op-empty--big">Nenhum ritual conhecido.</p>
	{{/each}}
</section>
