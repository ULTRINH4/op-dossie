<header class="op-head">
	{{#if semClasse}}
	<div class="op-callout">
		<p><strong>Ficha em branco.</strong> O assistente monta atributos, origem, classe, perícias e trilha pelas Regras da Mesa.</p>
		<button type="button" class="op-btn op-btn--primary" data-action="assistente"><i class="fa-solid fa-id-card" aria-hidden="true"></i> Abrir o assistente</button>
	</div>
	{{/if}}
	<div class="op-head__top">
		<button type="button" class="op-portrait" data-action="trocarImagem" aria-label="Trocar retrato" {{disabled (not editable)}}>
			<img src="{{actor.img}}" alt="">
		</button>

		<div class="op-ident">
			<p class="op-eyebrow">Dossiê de agente{{#if patente}} · {{patente}}{{/if}}</p>
			<input class="op-ident__name" name="name" type="text" value="{{actor.name}}" placeholder="Nome do agente" aria-label="Nome" {{disabled (not editable)}}>
			<div class="op-ident__meta">
				{{#each identidade}}
				<div class="op-select" {{#if id}}data-item-id="{{id}}"{{/if}}>
					<span class="op-select__label">{{label}}</span>
					{{#if id}}<button type="button" class="op-ident__chip" data-action="abrir">{{name}}</button>
					{{else}}<span class="op-ident__chip is-empty">—</span>{{/if}}
				</div>
				{{/each}}
			</div>
		</div>

		<div class="op-stamp {{#if progress.largo}}op-stamp--largo{{/if}}" data-tooltip="{{progress.label}}">
			<span class="op-stamp__label">{{progress.label}}</span>
			<span class="op-stamp__value">
				<input type="number" name="{{progress.name}}" value="{{progress.value}}" min="{{progress.min}}" max="{{progress.max}}" step="1" aria-label="{{progress.label}}" {{disabled (not editable)}}>{{#if progress.suffix}}<span>{{progress.suffix}}</span>{{/if}}
			</span>
			{{#if progress.nex}}<span class="op-stamp__sub">NEX {{progress.nex}}%</span>{{/if}}
			{{#if progress.sub}}<span class="op-stamp__sub">{{progress.sub}}</span>{{/if}}
			{{#if (and editable (not semClasse))}}<button type="button" class="op-stamp__up" data-action="subirNivel" data-tooltip="Subir de nível" aria-label="Subir de nível"><i class="fa-solid fa-angles-up" aria-hidden="true"></i> Subir</button>{{/if}}
		</div>

		{{#if editable}}
		<button type="button" class="op-icon-btn {{#if edit}}is-on{{/if}}" data-action="edicao" data-tooltip="{{#if edit}}Sair do modo de edição{{else}}Modo de edição{{/if}}" aria-pressed="{{edit}}" aria-label="Modo de edição">
			<i class="fa-solid fa-pen-ruler" aria-hidden="true"></i>
		</button>
		{{/if}}
	</div>

	<div class="op-bars">
		{{#each bars}}
		<div class="op-bar op-bar--{{key}} {{#if low}}is-low{{/if}}">
			<div class="op-bar__head">
				<span class="op-bar__label">{{label}} <abbr>{{abv}}</abbr>{{#if temp}} <span class="op-bar__temp" data-tooltip="Temporários">+{{temp}}</span>{{/if}}</span>
				<span class="op-bar__nums">
					<input type="number" name="system.recursos.{{key}}.valor" value="{{value}}" aria-label="{{label}} atual" {{disabled (not ../editable)}}>
					<span class="op-bar__max">/ {{max}}</span>
				</span>
			</div>
			<div class="op-bar__track" aria-hidden="true"><span style="width: {{pct}}%"></span></div>
			{{#if ../editable}}
			<div class="op-bar__btns">
				<button type="button" data-action="ajustar" data-key="{{key}}" data-step="-1" aria-label="Diminuir {{label}}" data-tooltip="−1 (Shift: −5)">−</button>
				<button type="button" data-action="ajustar" data-key="{{key}}" data-step="1" aria-label="Aumentar {{label}}" data-tooltip="+1 (Shift: +5)">+</button>
			</div>
			{{/if}}
			{{#if ../edit}}
			<label class="op-bar__extra">Bônus no máximo <input type="number" name="system.recursos.{{key}}.bonusMax" value="{{lookup (lookup ../system.recursos key) 'bonusMax'}}"></label>
			{{/if}}
		</div>
		{{/each}}
		<div class="op-chipstat" data-tooltip="Limite de gasto por rodada">
			<span>{{perRound.label}}</span><strong>{{perRound.value}}</strong>
		</div>
	</div>

	<div class="op-attrs">
		<ul class="op-attrs__list">
			{{#each attrs}}
			<li class="op-attr" data-key="{{key}}">
				<button type="button" class="op-attr__roll" data-action="rolarAtributo" data-tooltip="Rolar {{nome}}">
					<span class="op-attr__abv">{{abv}}</span>
					{{#unless ../edit}}<span class="op-attr__value">{{value}}</span>{{/unless}}
				</button>
				{{#if ../edit}}<input class="op-attr__input" type="number" name="system.atributos.{{key}}.valor" value="{{value}}" min="0" aria-label="{{nome}}">{{/if}}
			</li>
			{{/each}}
		</ul>
		<dl class="op-derived">
			{{#each derived}}<div class="{{#if cond}}is-cond{{/if}}" {{#if cond}}data-tooltip="{{cond}}"{{/if}}><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}
		</dl>
	</div>
	{{#if condicoesAtivas.length}}
	<ul class="op-condbar" aria-label="Condições ativas">
		{{#each condicoesAtivas}}
		<li class="op-condbar__item {{#if implicita}}is-implied{{/if}}" data-tooltip="{{dica}}"><img src="{{img}}" alt="">{{nome}}</li>
		{{/each}}
	</ul>
	{{/if}}
</header>
